# ============================================================
# K-Stock Backend — Flask + Gunicorn
# Google Cloud Run 배포용
# ============================================================
FROM python:3.11-slim

# 시스템 의존성 (pykrx 등에 필요)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# 의존성 먼저 설치 (캐시 활용)
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 앱 코드 복사
COPY flask_app.py .
COPY kr_market/ kr_market/
COPY engine/ engine/
COPY data/ data/
COPY templates/ templates/
COPY config/ config/
COPY quick_scan.py run_v2_scoring.py refresh_ai_cache.py ./

# 데이터 디렉토리 확보
RUN mkdir -p kr_market/data logs

# Cloud Run은 PORT 환경변수를 주입함
ENV PORT=8080
ENV PYTHONUNBUFFERED=1
ENV FLASK_DEBUG=false

EXPOSE 8080

# Gunicorn으로 프로덕션 서빙
# --timeout 120: AI 분석 API가 오래 걸릴 수 있음
# --workers 2: Cloud Run 기본 vCPU에 적합
CMD exec gunicorn \
    --bind 0.0.0.0:$PORT \
    --workers 2 \
    --threads 4 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile - \
    flask_app:app
